{
  "name": "magpie-not-enough-llama",
  "version": "0.1.0",
  "description": "magpie provider that starts a local llama-server on demand and stops it when idle",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "llama.cpp",
    "gguf",
    "local"
  ],
  "license": "MIT",
  "author": "zerodegress",
  "magpie": {
    "maxConcurrency": 4
  }
}
